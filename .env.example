# Root Environment Variables for Docker Compose

PORT=5000
MONGODB_URI=mongodb://mongodb:27017/algoforge
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=production_ready_jwt_secret_key_change_me_in_production
# TLS-protected Docker-compatible endpoint on the isolated executor fleet.
# The API and queue workers must never receive /var/run/docker.sock.
SANDBOX_DOCKER_HOST=tcp://isolated-executor.internal:2376
CLIENT_URL=http://localhost:5173
CLIENT_ID=
CLIENT_SECRET=
VITE_API_URL=http://localhost:5000/api
