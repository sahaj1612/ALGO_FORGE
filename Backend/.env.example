# AlgoForge Backend Configuration

# Server Port
PORT=5000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/algoforge

# Redis Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Secret Key (required: replace with cryptographically secure random string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters

# Frontend Client URL (for CORS and OAuth redirect)
CLIENT_URL=http://localhost:5173

# Optional: Google OAuth 2.0 Credentials
CLIENT_ID=
CLIENT_SECRET=
